# ─────────────────────────────────────────────────────────────
#  AetherSMP — пример переменных окружения
#  Скопируйте в .env и замените все секреты:
#    cp .env.example .env && openssl rand -hex 48
# ─────────────────────────────────────────────────────────────

# ── Режим ────────────────────────────────────────────────────
NODE_ENV=development

# ── База данных (PostgreSQL) ─────────────────────────────────
POSTGRES_USER=aether
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=aethersmp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aether:CHANGE_ME_strong_db_password@localhost:5432/aethersmp?schema=public

# ── API ──────────────────────────────────────────────────────
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
# Внутренний адрес API для Next.js rewrites (в Docker — http://api:4000)
API_INTERNAL_URL=http://localhost:4000
# Разрешённые origin'ы для прямых запросов к API (через запятую)
CORS_ORIGINS=http://localhost:3000

# ── JWT / сессии ─────────────────────────────────────────────
# Минимум 64 случайных символа. Разные значения для access и refresh!
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_at_least_64_random_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_at_least_64_random_chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=
# true только если сайт работает по HTTPS (production)
COOKIE_SECURE=false

# ── Первый владелец (создаётся сидом) ────────────────────────
SEED_OWNER_EMAIL=owner@aethersmp.local
SEED_OWNER_USERNAME=Owner
SEED_OWNER_PASSWORD=ChangeMe_StrongPass1!
SEED_OWNER_MC_NAME=Notch

# ── Minecraft / Mojang ───────────────────────────────────────
# Таймаут запросов к api.mojang.com, мс
MOJANG_TIMEOUT_MS=6000
# Разрешить регистрацию без проверки ника в Mojang (только для оффлайн-режима)
ALLOW_UNVERIFIED_MC=false

# ── RCON (мост к игровому серверу) ───────────────────────────
RCON_ENABLED=false
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=CHANGE_ME_rcon_password
RCON_TIMEOUT_MS=5000
# Команда выдачи расы, {player} и {race} подставляются.
# Для плагина, читающего permission-узлы, можно использовать:
#   lp user {player} permission set race.{race} true
RCON_RACE_COMMAND=lp user {player} permission set race.{race} true
RCON_UNRACE_COMMAND=lp user {player} permission unset race.{race}
RCON_RANK_COMMAND=lp user {player} parent set {rank}

# ── Web ──────────────────────────────────────────────────────
WEB_PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api

# ── Прочее ───────────────────────────────────────────────────
# Соль для хэширования IP в логах (GDPR-дружелюбно)
IP_HASH_SALT=CHANGE_ME_ip_hash_salt
